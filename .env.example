# ============================================================================
# CANON — Environment Configuration
# Public Elysium endpoints work out of the box with zero paid keys.
# Copy this file to .env before starting the app: cp .env.example .env
# ============================================================================

# 1. Server Configuration
PORT=3000

# 2. Blockchain RPC (Defaults to public Elysium Testnet)
VITE_RPC_URL="https://testnet-rpc.elysium.kinetiq.xyz"
VITE_DEPLOYMENT="elysium-testnet"

# 3. Mobile Wallet Pairing (WalletConnect / Reown)
# Free Project ID from https://cloud.reown.com
VITE_WC_PROJECT_ID=""

# 4. Optional Custom Local Wallet (Defaults to connected browser wallet)
VITE_DEV_WALLET=""

# 5. Optional Worker & Passport Endpoint
PASSPORT_API=""

# 6. Optional Testnet Deployment & Keeper Keys (For scripts/ only)
DEPLOYER_KEY=""
KEEPER_KEY=""
TEAM_BPS="1500"

# 7. Optional Gemini API Key
GEMINI_API_KEY=""
