# ============================================================================
# CANON — Environment Configuration
# Zero paid API keys are required to run CANON on Elysium Testnet (Chain 99801).
# Public Elysium & Hyperliquid endpoints work out of the box.
# ============================================================================

# 1. WalletConnect / Reown Project ID (Mobile QR & Deep-Link Wallet Pairing)
# Get a free Project ID at: https://dashboard.reown.com
VITE_WC_PROJECT_ID=""

# 2. Chain RPC Override (Defaults to public Elysium Testnet RPC)
VITE_RPC_URL="https://testnet-rpc.elysium.kinetiq.xyz"
VITE_DEPLOYMENT="elysium-testnet"

# 3. HYPE Pass Worker URL (Set after deploying workers/passport-worker to Cloudflare)
# Example: https://canon-passport-worker.<your-subdomain>.workers.dev
PASSPORT_API=""

# 4. Optional Terminal Deploy & Keeper Variables (Only used by npm run testnet:deploy / keeper:once)
DEPLOYER_KEY=""
KEEPER_KEY=""
TEAM_BPS="1500"

# 5. Hosted App URL (Auto-injected in cloud environments)
APP_URL=""

# 6. Gemini API Key (Optional)
GEMINI_API_KEY=""
